# Free keys — get them at https://aistudio.google.com/apikey and https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional local "privacy mode" (needs Ollama installed): http://localhost:11434
OLLAMA_URL=
# Optional: free Supabase/Neon Postgres, e.g. postgresql://user:pass@host:5432/db  (default: local SQLite)
# DATABASE_URL=
# Optional: GitHub personal token for higher API limits / private repos
GITHUB_TOKEN=
# Set both when exposing the API to the internet (Cloudflare Tunnel): see deploy/README.md
# API_TOKEN=some-long-random-string
# ALLOW_LOCAL_IMPORT=false
