// Cloudflare Workers deploy for the React web app (free tier).
// Deploy: npm run build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devmate-ai",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/backend-url"]
  },
  // Holds the current backend (tunnel) URL.
  "kv_namespaces": [{ "binding": "DEVMATE_CONFIG", "id": "f15bfb27df344a1aba01d6e18e714757" }]
}
